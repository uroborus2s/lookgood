# 运行模式：mock = 不调用任何付费 API（本地开发默认）；live = 已填写密钥的那一项走真实接口
PROVIDER_MODE=mock
PORT=3000
# 生产环境必须是 production，此时 JWT_SECRET 不是 32 字节以上随机值会拒绝启动
NODE_ENV=development

# ---- 对话 / 方案生成 / 看图：均为 OpenAI 兼容接口，换家只改这里 ----
# 主选 DeepSeek
LLM_CHAT_BASE_URL=https://api.deepseek.com
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=deepseek-flash
# 备用：通义千问（百炼 OpenAI 兼容模式）
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen-plus
# look_spec 结构化生成
LLM_SPEC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SPEC_API_KEY=
LLM_SPEC_MODEL=qwen3.7-plus
# 看图诊断（VL）
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=qwen3-vl-plus
# 豆包示例：LLM_FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_FALLBACK_MODEL=doubao-seed-2.0-mini

# ---- 百炼图像（试衣 / 整体造型）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TRYON_MODEL=qwen-image-3.0
FULLLOOK_MODEL=wan2.7-image

# ---- 腾讯云人脸试妆（试唇色）----
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# ---- 阿里云 OSS（私有桶；原图 raw/ 24h 删除，生成图 gen/ 长期保存）----
OSS_REGION=cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_MAX_BYTES=10485760
IMAGE_TTL_HOURS=24

# 隐式 AI 标识。生产者名称上线前换成主体名称；ReservedCode 用 HMAC，未设置密钥时退化为 SHA-256 摘要
AIGC_CONTENT_PRODUCER=一身好看
AIGC_CONTENT_PROPAGATOR=一身好看
AIGC_RESERVED_SECRET=

# ---- 微信小程序登录 ----
WX_APPID=
WX_SECRET=

# ---- 内容安全：mock | wechat | aliyun。只有 PROVIDER_MODE=live 才会真正调用 ----
CONTENT_SAFETY=mock
# 微信 msgSecCheck / mediaCheckAsync。scene：1 资料 2 评论 3 论坛 4 社交日志
WX_SAFETY_SCENE=2
# 消息推送令牌。安全模式才需要 EncodingAESKey（43 位）
WX_SAFETY_TOKEN=
WX_SAFETY_ENCODING_AES_KEY=
# 阿里云内容安全增强版 green-cip。不填 endpoint 时用 https://green-cip.${REGION}.aliyuncs.com
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION=cn-shanghai
ALIYUN_GREEN_ENDPOINT=
ALIYUN_GREEN_TEXT_SERVICE=comment_detection_pro
ALIYUN_GREEN_IMAGE_SERVICE=baselineCheck

# ---- 微信支付 v3（会员）。密钥是 32 字节 APIv3 key；私钥 / 平台证书支持用 \n 表示换行 ----
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_CERT_SERIAL=
WX_PAY_PRIVATE_KEY=
WX_PAY_PLATFORM_CERT=
WX_PAY_PLATFORM_SERIAL=
WX_PAY_NOTIFY_URL=https://你的域名/pay/wechat/notify
# 不填则使用默认 12.9 / 29 / 198 元。金额单位是分。
# MEMBER_PLANS=[{"sku":"month","title":"月卡","amountFen":1290,"days":30},{"sku":"quarter","title":"季卡","amountFen":2900,"days":90},{"sku":"year","title":"年卡","amountFen":19800,"days":365}]

# ---- 每日生成次数（北京时间自然日）。会员看 member_expire_at ----
FREE_DAILY_QUOTA=5
MEMBER_DAILY_QUOTA=100
# 模型单价（元/次）。键要和实际 model / provider.name 一致：
#   对话类用模型 id（如 deepseek-flash、qwen-plus）；mock 对话是 mock
#   试衣 live 是 TRYON_MODEL，造型/发型 live 是 FULLLOOK_MODEL，唇色 live 是 tencent-fmu
#   mock 渲染的键是 tryon、lip、hair、fulllook
# 没写上的模型会记一笔「未定价」，不会当成 0 元。
# MODEL_UNIT_PRICE_CNY=deepseek-flash=0.001,qwen-image-3.0=0.2,wan2.7-image=0.14,tencent-fmu=0.08

# ---- 数据库 ----
REPO=memory
# REPO=pg
# DATABASE_URL=postgres://yishen:yishen@127.0.0.1:5432/yishen

# 生产环境用 openssl rand -base64 48 生成，至少 32 字节且像随机值，否则进程拒绝启动
JWT_SECRET=dev-only-not-for-production
JWT_TTL_SEC=604800
LLM_SLOTS_MODEL=qwen-plus
