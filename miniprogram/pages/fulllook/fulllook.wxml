<view class="card">
  <image wx:if="{{img}}" src="{{img}}" mode="widthFix"/>
  <view wx:elif="{{status}}" class="loading">{{status}}</view>
  <view wx:elif="{{error}}" class="err">{{error}}</view>
  <view class="ai">AI 生成</view>
</view>
<button bindtap="fav" disabled="{{!img}}">收藏</button>
<button class="btn" open-type="share" disabled="{{!img}}">分享</button>
